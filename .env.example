PORT=3001

# Datos de la base de datos local de postgres
POSTGRES_USER=safepath
POSTGRES_PASSWORD=safepath
POSTGRES_DB=safepath
POSTGRES_PORT=5432

# Direccion que usa la api cuando corre sin docker con npm run start:dev
# en docker se arma sola en el docker-compose
DATABASE_URL=postgres://safepath:safepath@localhost:5432/safepath

# Conexion cifrada con TLS hacia la base y verificando su certificado
# false solo para el postgres local de docker que no tiene TLS; sin la variable o con otro valor se usa TLS
DATABASE_SSL=false
# Ruta al certificado de la autoridad que firmo el de la base, en RDS el global-bundle.pem de AWS
# vacio usa los certificados de confianza que trae Node
DATABASE_SSL_CA=

# Puerto de adminer para ver la base de datos en el navegador
ADMINER_PORT=8081

# Direccion del frontend que puede llamar a la api y vacio deja entrar a cualquiera
CORS_ORIGIN=

# Secreto con el que se firman los tokens JWT del dashboard y de la app movil
# es obligatorio y la api no arranca sin el o si tiene menos de 32 caracteres
# genera uno propio y distinto para cada entorno con
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Primer administrador del dashboard: la api lo crea al arrancar si la base no tiene ningun administrador
# debe cambiar la contrasena en su primer ingreso y si ya existe un administrador no se hace nada
# la contrasena necesita de 8 a 72 caracteres con mayuscula minuscula y numero
# con un formato invalido o solo una de las dos la api no arranca; en AWS van en Secrets Manager
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Direccion del frontend del dashboard para armar el enlace de restablecer la contrasena
# por ejemplo http://localhost:5173 y vacio solo deja la ruta en el enlace
DASHBOARD_URL=

# Servidor de correo para enviar el enlace de restablecer la contrasena
# sin SMTP_HOST el enlace no se envia y queda escrito en el registro de la api
# SMTP_SECURE es true solo con el puerto 465 y con 587 se deja en false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Llave de Google con Routes API activada, para que /routes trace los caminos por calles reales
# sin ella las rutas salen solo de la red de ciclovias, con rectas hasta llegar a ellas
GOOGLE_MAPS_API_KEY=

# Direccion publica de la api para los enlaces Acepto y No acepto del correo de invitacion a un contacto de emergencia
# el contacto los abre desde su propio celular asi que en produccion debe ser la direccion publica; vacia usa http://localhost:PORT
API_URL_PUBLICA=

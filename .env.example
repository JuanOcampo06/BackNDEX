PORT=3001

# Datos de la base de datos local de postgres
POSTGRES_USER=safepath
POSTGRES_PASSWORD=safepath
POSTGRES_DB=safepath
POSTGRES_PORT=5432

# Direccion que usa la api cuando corre sin docker con npm run start:dev
# en docker se arma sola en el docker-compose
DATABASE_URL=postgres://safepath:safepath@localhost:5432/safepath

# Puerto de adminer para ver la base de datos en el navegador
ADMINER_PORT=8081

# Direccion del frontend que puede llamar a la api y vacio deja entrar a cualquiera
CORS_ORIGIN=

# Secreto con el que se firman los tokens JWT de la app movil
# en produccion debe ser largo y distinto para cada entorno
JWT_SECRET=cambia-este-secreto-en-produccion
